<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CityExplorerAiron.ViewModels"
             xmlns:models="clr-namespace:CityExplorerAiron.Models"
             x:Class="CityExplorerAiron.Views.FavoritesPage"
             x:DataType="viewModels:FavoritesViewModel"
             x:Name="FavoritesPageRef" 
             Title="Lemmikud">

    <VerticalStackLayout Padding="20">
        <Label Text="{Binding FavoritesHeaderText}" 
               FontSize="28" 
               FontAttributes="Bold" 
               Margin="0,0,0,20"/>

        <CollectionView ItemsSource="{Binding FavoriteLandmarks}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Landmark">
                    <!-- Column 0: Emoji (Auto width) -->
                    <!-- Column 1: Text details (Takes remaining space *) -->
                    <!-- Column 2: Static Delete Button (Auto width) -->
                    <Grid Padding="15" ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">

                        <!-- Category Emoji -->
                        <Label Grid.Row="0" 
                               Grid.Column="0" 
                               Grid.RowSpan="2"
                               VerticalOptions="Center"
                               Text="{Binding CategoryEmoji}" 
                               FontSize="20" 
                               Margin="0,0,10,0" />

                        <!-- Name -->
                        <Label Grid.Row="0" 
                               Grid.Column="1" 
                               Text="{Binding Name}" 
                               FontSize="18" 
                               FontAttributes="Bold" />

                        <!-- Description -->
                        <Label Grid.Row="1" 
                               Grid.Column="1" 
                               Text="{Binding Description}" 
                               FontSize="13" 
                               TextColor="Gray" 
                               MaxLines="1" />

                        <!-- Static Kustuta Button -->
                        <Button Grid.Row="0" 
                                Grid.Column="2" 
                                Grid.RowSpan="2"
                                Text="Kustuta"
                                BackgroundColor="Tomato"
                                TextColor="White"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                Margin="10,0,0,0"
                                Command="{Binding BindingContext.DeleteFavoriteCommand, Source={x:Reference FavoritesPageRef}}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="{Binding FavoriteEmpty}"
                       HorizontalOptions="Center" 
                       Margin="0,50,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>